# --- Python ---
__pycache__/
*.pyc
venv/
.venv/

# --- Secrets / local config (reserved) ---
.env
.env.*

# --- Runtime caches of external data (regenerable; access-politeness rules in CLAUDE.md) ---
# 国土地理院 標高タイル(約23GB)
step2_terrain/dem_cache/
# Light Pollution Atlas バイナリタイル
step3_light_pollution/tile_cache/
# NASA Black Marble の生HDF5と比較用の中間生成物(約1GB。段階LP1、年1回の再生成で作り直せる)
step3_light_pollution/blackmarble_cache/
# Open-Meteo 格子セルキャッシュ(TTL付き)
step5_cloud_forecast/cloud_cache/
# 気象庁天気図スクリーンショット
step5_cloud_forecast/weather_map_cache/
# 気象衛星ひまわりのタイル・モザイク
step5_cloud_forecast/himawari_cache/

# --- Skyfield ephemeris (17MB, auto-downloaded on first use) ---
*.bsp

# --- Backups taken before batch data edits ---
*.bak
*.bak2
*.bak_*
stargazing_spots.json.bak_*.json
# 実行ログはlogs/に置く。直下のログは追跡しない
/*.log

# 星空ガイドなどの生成物の出力先
out/

# 生成物(generate_report.py が毎回上書きする。古い版が残ると誤読されるため追跡しない)
/report.html
# 光害の入力をlegacy(LPI)にして生成したレポート(段階LP3。既定のbmは report.html)
/report_legacy.html
# 段階LP2で作った試験用レポート(段階LP3以降は生成しない)
/report_bm.html
/artifact_report.html

# 天気図の解説文(generate_report.py が読む。手で更新する運用、AGENTS.md参照)
/weather_map_commentary.json
